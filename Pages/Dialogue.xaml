<Window x:Class="UIKitTutorials.Pages.Dialogue"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UIKitTutorials.Pages"
        mc:Ignorable="d"
        d:DesignHeight="300" d:DesignWidth="450"
        WindowStyle="None"
        ResizeMode="NoResize" WindowState="Normal"
        Title="Dialogue" Height="300" Width="450" Closing="Window_Closing">
    <Border CornerRadius="5" Background="{DynamicResource SecundaryBackgroundColor}">
        <Grid>
            <Button Content="{DynamicResource close}" Style="{DynamicResource IconButtonsStyle}" HorizontalAlignment="Left" Margin="397,267,0,0" VerticalAlignment="Top" Height="23" Width="43" Click="Button_Click"/>
            <Grid Name="drag">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*"/>
                    <RowDefinition Height="71*"/>
                </Grid.RowDefinitions>
                <Rectangle HorizontalAlignment="Center" Height="217" Margin="0,23,0,0" Stroke="Black" VerticalAlignment="Top" Width="430" Grid.Row="1"/>
                <Label Content="The Following Error Occurred" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="24" Width="176" Grid.RowSpan="2"/>
                <ScrollViewer x:Name="scroll" HorizontalAlignment="Center" Height="217" Margin="0,23,0,0" VerticalAlignment="Top" Width="430" Grid.Row="1">
                    <TextBlock x:Name="textblock"  TextWrapping="Wrap" />
                </ScrollViewer>


            </Grid>
        </Grid>
    </Border>
</Window>
